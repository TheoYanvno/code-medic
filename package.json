{
  "name": "code-medic",
  "displayName": "Code Medic",
  "description": "Finds common mistakes in JavaScript, TypeScript and Python as you type, explains each one in plain words, and offers two ways to fix it.",
  "version": "0.1.0",
  "publisher": "theoyanvno",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Linters",
    "Education"
  ],
  "keywords": [
    "linter",
    "quick fix",
    "beginner",
    "javascript",
    "python"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeMedic.checkFile",
        "title": "Code Medic: Check this file"
      }
    ],
    "configuration": {
      "title": "Code Medic",
      "properties": {
        "codeMedic.enable": {
          "type": "boolean",
          "default": true,
          "description": "Check files as you type."
        },
        "codeMedic.disabledRules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "enum": [
              "loose-equality",
              "no-var",
              "no-console-log",
              "no-debugger",
              "bare-except",
              "mutable-default",
              "none-comparison",
              "leftover-print",
              "no-explicit-any",
              "non-null-assertion"
            ]
          },
          "description": "Rules to turn off, for example [\"no-var\"]."
        },
        "codeMedic.severity": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info",
              "off"
            ]
          },
          "description": "Change how a rule shows up, for example { \"loose-equality\": \"error\" }. \"off\" turns it off."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
