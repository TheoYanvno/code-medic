{
  "name": "code-medic",
  "displayName": "Code Medic",
  "description": "Finds common mistakes in JavaScript, TypeScript and Python as you type, explains each one in plain words, and offers two ways to fix it.",
  "version": "0.1.0",
  "publisher": "theoyanvno",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": ["Linters", "Education"],
  "keywords": ["linter", "quick fix", "beginner", "javascript", "python"],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      { "command": "codeMedic.checkFile", "title": "Code Medic: Check this file" }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
